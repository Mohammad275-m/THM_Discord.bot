# Never paste your token into chat or commit .env.
DISCORD_TOKEN=
# Optional: fast command sync in ONE development guild. Empty = global sync.
DISCORD_DEV_GUILD_ID=
POLL_INTERVAL_SECONDS=600
REQUEST_INTERVAL_SECONDS=2
HTTP_TIMEOUT_SECONDS=20
# Maximum duration of a complete profile + all-pages scan; incomplete scans never commit.
POLL_TIMEOUT_SECONDS=120
# Empty User-Agent automatically matches the curl_cffi Chrome HTTP/TLS profile.
# No user session cookies, authentication, proxy rotation or challenge solving.
THM_USER_AGENT=
THM_ACCEPT_LANGUAGE=en-US,en;q=0.9
MAX_IMAGE_BYTES=4194304
DATABASE_PATH=data/bot.sqlite3
VERIFY_TTL_SECONDS=900
# Optional absolute/local font path; bundled fonts are used by default.
FONT_PATH=
# Exact HTTPS hosts only. No wildcard hosts, redirects, private IPs or cookies.
IMAGE_ALLOWED_HOSTS=tryhackme.com,assets.tryhackme.com,cdn.tryhackme.com,cdn-images.tryhackme.com,tryhackme-images.s3.amazonaws.com,tryhackme-images.s3.eu-west-1.amazonaws.com,cdn.discordapp.com,media.discordapp.net
